        <type>std::vector&lt; std::pair&lt; std::shared_ptr&lt; <ref refid="structfccvis_1_1scene_1_1meta_1_1LayoutNode" kindref="compound">LayoutNode</ref> &gt;, int &gt; &gt;</type>
