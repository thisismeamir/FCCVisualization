# Documentation example: detector geometry (docs/source/adapters/detector.md).
# [detector]
load detector ../../tests/data/detector/toy.xml depth=3
series
scene new side
layer add side geometry/Tracker as tracker
layer add side geometry/BeamPipe as pipe
layer add side geometry/Shield as shield
style side/tracker preset detector-outline
style side/tracker when material == "Silicon" then color=accent opacity=0.6
style side/shield color=#8d8d8d opacity=0.5
camera side dir 1 0 0
backend init raster png output_dir=detector-out width=480 height=360
open png side
backend flush
# [detector]
